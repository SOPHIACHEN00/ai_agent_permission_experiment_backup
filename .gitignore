# Python environments (including nested experiments)
**/.venv/
**/venv/

# Python caches and test artifacts
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Local credentials and environment files
**/.env
**/.env.*
!**/.env.example

# SQLite transient files
**/*.sqlite3-wal
**/*.sqlite3-shm

# Preserved nested-repository metadata during outer backup
**/.git.source-history/

# Large local training evidence and disposable server/runtime bundles
**/*.jsonl
**/*.pt
**/*.zip
**/*.sqlite3
**/*.log
**/*.exit
**/*.exit_code
rl_personal_assistant/tmp*/
agent_permission_harness_v1/remote_patch_staging/*
!agent_permission_harness_v1/remote_patch_staging/*.patch
agent_permission_harness_v1/results/**/*.gz
