--- /dev/null
+++ b/agent_permission_harness_v1/tests/test_sqstn_bridge.py
@@ -0,0 +1,112 @@
+"""Memory and pending-authority bridge tests against the real kernel."""
+from dataclasses import replace
+import json
+from pathlib import Path
+from tempfile import TemporaryDirectory
+import unittest
+from pa_rl.contracts import ControllerAction as A, PermissionChoice as P, PublicEvent, contract_json_round_trip
+from agent_permission_harness_v1.human_channel import LocalHumanChannel
+from agent_permission_harness_v1.learning_environment import AgentLearningEnvironment
+from agent_permission_harness_v1.learning_scenarios import staged_note_task, ReactiveReadPlanner
+from agent_permission_harness_v1.runner import AgentSession
+from agent_permission_harness_v1.online_budget import OnlineBudget
+from agent_permission_harness_v1.online_transport import OpenAIJSONTransport
+from test_online_transport import response
+from test_learning_environment import select
+
+def kernel_snapshot(env):
+    return {'records':contract_json_round_trip(env.session.ledger.records()),
+            'events':contract_json_round_trip(env.session.ledger.events())}
+
+def waiting_env(action=A.REQUEST_AUTHORIZATION):
+    env=AgentLearningEnvironment(AgentSession(staged_note_task(1),ReactiveReadPlanner(),channel=LocalHumanChannel()))
+    boundary=env.start()
+    env.step(select(boundary,action,1 if action==A.REQUEST_AUTHORIZATION else None),
+             decision_token=boundary.token)
+    mid=env.session._waiting.message_id
+    return env,env.session.channel._messages[mid]
+
+class BridgeTests(unittest.TestCase):
+    def make(self,d,answer='allow_once'):
+        from agent_permission_harness_v1.sqstn_memory import SqstnMemory
+        from agent_permission_harness_v1.sqstn_human import SqstnHuman
+        budget=OnlineBudget(Path(d),caps_nusd={'human':4_000_000_000,'task':5_000_000_000},
+                            call_caps={'human':129,'task':676})
+        self.addCleanup(budget.close)
+        prompts=[]
+        def request(payload):
+            prompts.append(payload['messages'][0]['content'])
+            return response(content=json.dumps({'answer':answer}))
+        transport=OpenAIJSONTransport(role='human',budget=budget,requester=request)
+        memory=SqstnMemory('user_A','PERSONA_SECRET: cautious about sensitive fields.')
+        memory.enter_task('task_1','Inspect synthetic note')
+        return memory,SqstnHuman(memory,transport),budget,prompts
+
+    def test_memory_survives_task_but_not_user(self):
+        with TemporaryDirectory() as d:
+            memory,human,budget,prompts=self.make(d)
+            env,message=waiting_env()
+            reply=human.reply(message,task_id='task_1',events=tuple(env.session._history),ledger_snapshot=kernel_snapshot(env))
+            env.session.channel.submit(reply); env.resume()
+            memory.observe_kernel('task_1',tuple(env.session._history),kernel_snapshot(env))
+            self.assertEqual(memory.view()['consent_history'][-1]['answer'],'allow_once')
+            old=memory.ordinal
+            memory.enter_task('task_2','Next note')
+            self.assertGreater(memory.ordinal,old)
+            self.assertEqual(memory.view()['consent_history'][-1]['task_id'],'task_1')
+            from agent_permission_harness_v1.sqstn_memory import SqstnMemory
+            other=SqstnMemory('user_B','Independent user')
+            self.assertEqual(other.view()['consent_history'],[])
+            restored=SqstnMemory.from_snapshot(memory.snapshot())
+            self.assertEqual(restored.view(),memory.view())
+            self.assertIn('allow_once',prompts[0])
+            self.assertNotIn('Synthetic planning detail',prompts[0])
+            for n in range(17): memory.enter_task('extra_'+str(n),'Fresh task')
+            self.assertEqual(memory.view()['consent_history'],[])
+            self.assertLessEqual(len(memory.view()['visible_events']),16)
+
+    def test_reply_requires_pending_and_matching_context(self):
+        with TemporaryDirectory() as d:
+            memory,human,budget,prompts=self.make(d)
+            env,message=waiting_env()
+            with self.assertRaises(ValueError):
+                human.reply(message,task_id='task_1',events=(),ledger_snapshot={'records':[],'events':[]})
+            self.assertEqual(budget.summary()['human']['attempts'],0)
+            kwargs=dict(task_id='task_1',events=tuple(env.session._history),ledger_snapshot=kernel_snapshot(env))
+            first=human.reply(message,**kwargs)
+            self.assertEqual(human.reply(message,**kwargs),first)
+            self.assertEqual(budget.summary()['human']['attempts'],1)
+            with self.assertRaises(ValueError):
+                human.reply(replace(message,message_id='wrong_id'),**kwargs)
+            with self.assertRaises(ValueError):
+                human.reply(replace(message,requested_scope=env.session.task.steps[0].request_scopes[-1]),**kwargs)
+            self.assertEqual(env.session.ledger.records()[0].status.value,'pending')
+            env.session.channel.submit(first)
+            with self.assertRaises(ValueError): env.session.channel.submit(first)
+
+    def test_verified_event_mapping(self):
+        with TemporaryDirectory() as d:
+            memory,human,budget,prompts=self.make(d,'deny_reask')
+            env,message=waiting_env()
+            reply=human.reply(message,task_id='task_1',events=tuple(env.session._history),ledger_snapshot=kernel_snapshot(env))
+            env.session.channel.submit(reply); env.resume()
+            events=tuple(env.session._history)
+            memory.observe_kernel('task_1',events,kernel_snapshot(env))
+            ordinal=memory.ordinal
+            memory.observe_kernel('task_1',events,kernel_snapshot(env))
+            self.assertEqual(memory.ordinal,ordinal)
+            types=memory.view()['visible_verified_event_types']
+            self.assertNotIn('verified_scope_violation',types)
+            self.assertNotIn('explicit_grant',types)
+            with self.assertRaises(ValueError):
+                memory.observe_kernel('task_1',(PublicEvent('permission_denied',{'reason':'changed'}),),kernel_snapshot(env))
+
+    def test_escalation_cannot_grant(self):
+        with TemporaryDirectory() as d:
+            memory,human,budget,prompts=self.make(d)
+            env,message=waiting_env(A.ESCALATE)
+            human.transport.requester=lambda p: response(content='{"kind":"clarification","text":"Only inspect the requested note."}')
+            reply=human.reply(message,task_id='task_1',events=tuple(env.session._history),ledger_snapshot=kernel_snapshot(env))
+            self.assertEqual(reply.kind,'clarification'); self.assertIsNone(reply.permission)
+            env.session.channel.submit(reply); env.resume()
+            self.assertEqual(env.session.ledger.records(),())
