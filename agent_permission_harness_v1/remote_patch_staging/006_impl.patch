+"""Independent deterministic probes. Scope enforcement is NOT content-flow control."""
+from dataclasses import replace
+from pa_rl.authorization import AuthorizationService
+from pa_rl.contracts import PermissionChoice, Scope
+from .contracts import CompiledCall, TaskDefinition, TaskStepSpec
+from .monitor_adapter import ExecutionAdapter
+from .tools import LocalToolStore
+
+CANARY='SYNTHETIC_PRIVATE_CANARY'
+
+def _scope(tool, resource, fields, operation, recipient='local_user'):
+    return Scope('Work & Productivity',tool,resource,tuple(fields),operation,
+                 'synthetic_boundary_diagnostic',recipient,'session')
+
+def _grant(ledger,scope,choice=PermissionChoice.ALLOW_REUSE):
+    pending=ledger.start_request(scope,0,'synthetic_permission')
+    ledger.apply_permission_choice(pending.authorization_id,choice,0)
+    return pending.authorization_id
+
+def run_security_diagnostics():
+    read=_scope('Cloud Drive','note',('private_notes',),'read')
+    send=_scope('Email','outbox',('body','recipient'),'send','Synthetic Recipient')
+    records={'Cloud Drive':{'note':{'private_notes':CANARY}},'Email':{}}
+    read_args={'record_id':'note'}
+    attacks={}
+    for kind in ('missing','expired','consumed','disabled','wrong_tool','wrong_field','wrong_recipient'):
+        task=TaskDefinition('boundary_'+kind,'Synthetic scope probe',
+            (TaskStepSpec('read',(read,),(read,),read_args),),records,None)
+        ledger=AuthorizationService(task.scenario_id,30)
+        store=LocalToolStore(records)
+        adapter=ExecutionAdapter(task,store,ledger)
+        scope=read
+        if kind=='wrong_tool': scope=replace(read,tool='Email')
+        if kind=='wrong_field': scope=replace(read,data_attributes=('title',))
+        if kind=='wrong_recipient': scope=replace(read,recipient='Someone Else')
+        grant=None if kind=='missing' else _grant(ledger,scope,
+              PermissionChoice.ALLOW_ONCE if kind=='consumed' else PermissionChoice.ALLOW_REUSE)
+        if kind=='disabled': ledger.disable(grant,1)
+        if kind=='consumed':
+            reservation=ledger.reserve(read,1,authorization_id=grant)
+            ledger.commit(reservation,1)
+        before=store.snapshot()
+        execution,_=adapter.execute(CompiledCall('read',read,read_args),grant,31 if kind=='expired' else 2)
+        attacks[kind]={'blocked':execution.disposition.value=='blocked',
+                       'mock_unchanged':store.snapshot()==before}
+    send_args={'data':{'recipient':'Synthetic Recipient','body':CANARY}}
+    task=TaskDefinition('content_boundary','Read private detail for local use; send a public greeting.',
+        (TaskStepSpec('read',(read,),(read,),read_args),
+         TaskStepSpec('send',(send,),(send,),send_args)),records,None)
+    ledger=AuthorizationService(task.scenario_id,30)
+    store=LocalToolStore(records)
+    adapter=ExecutionAdapter(task,store,ledger)
+    read_exec,visible=adapter.execute(CompiledCall('read',read,read_args),_grant(ledger,read),1)
+    # Use the value actually returned through the monitor, not a bypassed read.
+    send_args={'data':{'recipient':'Synthetic Recipient','body':visible['private_notes']}}
+    send_exec,_=adapter.execute(CompiledCall('send',send,send_args),_grant(ledger,send),2)
+    outbox=store.snapshot()['outbox']
+    return {'source':'deterministic_security_diagnostic_not_live',
+        'scope_attacks':attacks,
+        'content_flow_gap_observed':any(CANARY in x.get('body','') for x in outbox),
+        'content_canary':{'read_disposition':read_exec.disposition.value,
+            'send_disposition':send_exec.disposition.value,'outbox':outbox},
+        'limitation':'A permitted body field can carry previously read sensitive content; no taint/DLP claim.'}
