--- /dev/null
+++ b/agent_permission_harness_v1/longitudinal_rollout.py
@@ -0,0 +1,48 @@
+"""Drive real Agent/HumanWait transitions without granting authority in the bridge."""
+from __future__ import annotations
+from .ddqn_policy import DDQNPermissionPolicy
+from .learning_contracts import DecisionBoundary,ClosedTransition,HumanWait,EpisodeEnd
+from .learning_environment import AgentLearningEnvironment
+from .sqstn_human import SqstnHuman
+from .sqstn_memory import ledger_snapshot
+
+class InteractiveEpisodeAborted(RuntimeError):
+    """Technical interruption, never an invented user denial or reward."""
+
+def drive_interactive_episode(environment: AgentLearningEnvironment,
+        policy: DDQNPermissionPolicy, human: SqstnHuman, *,
+        task_id: str, epsilon: float, learn: bool) -> EpisodeEnd:
+    if type(learn) is not bool or not isinstance(policy,DDQNPermissionPolicy):
+        raise ValueError('typed_learning_policy_required')
+    if learn != policy.training or (not learn and epsilon != 0):
+        raise ValueError('training_and_frozen_modes_must_be_explicit')
+    session=environment.session
+    if session.channel._responder is not None:
+        raise ValueError('external_human_channel_required')
+    human.memory.enter_task(task_id,session.task.goal)
+    outcome=environment.start()
+    while True:
+        # AgentSession deliberately sanitizes exceptions into statuses. Detect
+        # these before observe(); a transport fault must not become reward zero.
+        if session._terminal in {'planner_error','human_error','dispatch_error','policy_error','execution_fault'}:
+            raise InteractiveEpisodeAborted('technical_episode_interruption')
+        human.memory.observe_kernel(task_id,tuple(session._history),ledger_snapshot(session))
+        if isinstance(outcome,EpisodeEnd):
+            return outcome
+        if isinstance(outcome,HumanWait):
+            mid=outcome.result.awaiting_message_id
+            message=session.channel._messages.get(mid)
+            if message is None: raise InteractiveEpisodeAborted('missing_pending_message')
+            reply=human.reply(message,task_id=task_id,events=tuple(session._history),
+                              ledger_snapshot=ledger_snapshot(session))
+            session.channel.submit(reply)
+            outcome=environment.resume()
+            continue
+        if isinstance(outcome,ClosedTransition):
+            if learn: policy.observe(outcome)
+            if outcome.done: return outcome.end
+            outcome=outcome.next_decision
+        if not isinstance(outcome,DecisionBoundary):
+            raise InteractiveEpisodeAborted('unknown_episode_boundary')
+        candidate=policy.select(outcome,epsilon=epsilon)
+        outcome=environment.step(candidate,decision_token=outcome.token)
