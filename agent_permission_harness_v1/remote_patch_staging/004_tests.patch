+"""Online-loop mechanics: real DDQN/kernel, fake external HTTP."""
+import json
+from pathlib import Path
+from tempfile import TemporaryDirectory
+import unittest
+from pa_rl.contracts import ControllerAction as A
+from pa_rl.ddqn import DDQNHyperparameters
+from agent_permission_harness_v1.ddqn_policy import DDQNPermissionPolicy
+from agent_permission_harness_v1.human_channel import LocalHumanChannel
+from agent_permission_harness_v1.learning_environment import AgentLearningEnvironment
+from agent_permission_harness_v1.learning_scenarios import staged_note_task,ReactiveReadPlanner
+from agent_permission_harness_v1.learning_contracts import EpisodeConfig
+from agent_permission_harness_v1.runner import AgentSession
+from agent_permission_harness_v1.online_budget import OnlineBudget
+from agent_permission_harness_v1.online_transport import OpenAIJSONTransport,LiveCallError
+from agent_permission_harness_v1.sqstn_memory import SqstnMemory
+from agent_permission_harness_v1.sqstn_human import SqstnHuman
+from test_online_transport import response
+
+HYPER=DDQNHyperparameters(gamma=1,batch_size=8,warmup_transitions=8,
+    replay_capacity=512,optimize_every=1,target_update_every=16)
+class FixtureDDQN(DDQNPermissionPolicy):
+    """Forced semantic actions prove integration, not learned behavior."""
+    def select(self,boundary,*,epsilon=0):
+        for action in (A.EXECUTE_WITH_AUTHORIZATION,A.REQUEST_AUTHORIZATION):
+            choices=[c for c in boundary.view.candidates if c.valid and c.action==action]
+            if choices:
+                return max(choices,key=lambda c:len((c.operation_scope or c.request_scope).data_attributes)).candidate_id
+        return super().select(boundary,epsilon=epsilon)
+
+def environment(planner=None):
+    return AgentLearningEnvironment(AgentSession(staged_note_task(1),
+        planner or ReactiveReadPlanner(),channel=LocalHumanChannel(),
+        max_control_steps=24,max_planner_turns=16),EpisodeConfig(3,20))
+
+def human_at(path,subject='user_A'):
+    budget=OnlineBudget(path,caps_nusd={'human':4_000_000_000,'task':5_000_000_000},
+                        call_caps={'human':129,'task':676})
+    transport=OpenAIJSONTransport(role='human',budget=budget,
+        requester=lambda p:response(content='{"answer":"allow_reuse"}'))
+    return SqstnHuman(SqstnMemory(subject,'PERSONA_SECRET: prefer bounded reuse for required data.'),transport),budget
+
+class RolloutTests(unittest.TestCase):
+    def test_two_tasks_keep_learner_not_authority(self):
+        from agent_permission_harness_v1.longitudinal_rollout import drive_interactive_episode
+        with TemporaryDirectory() as d:
+            human,budget=human_at(Path(d))
+            self.addCleanup(budget.close)
+            policy=FixtureDDQN(seed=17,device='cpu',hyperparameters=HYPER)
+            envs=[]
+            for n in range(2):
+                env=environment()
+                self.assertEqual(env.session.ledger.records(),())
+                end=drive_interactive_episode(env,policy,human,task_id=f'task_{n}',epsilon=0,learn=True)
+                self.assertEqual(end.reward,1)
+                self.assertEqual(len(env.transitions),4)
+                envs.append(env)
+            self.assertEqual(policy.learner.environment_steps,8)
+            self.assertEqual(policy.learner.replay_size,8)
+            self.assertEqual(policy.learner.optimizer_steps,1)
+            self.assertEqual(budget.summary()['human']['attempts'],2)
+            self.assertTrue(human.memory.view()['consent_history'])
+            self.assertIsNot(envs[0].session.ledger,envs[1].session.ledger)
+
+    def test_wait_resume_observe_once_and_frozen(self):
+        from agent_permission_harness_v1.longitudinal_rollout import drive_interactive_episode
+        from agent_permission_harness_v1.learning_rollout import training_state_digest
+        with TemporaryDirectory() as d:
+            human,budget=human_at(Path(d)); self.addCleanup(budget.close)
+            policy=FixtureDDQN(seed=17,device='cpu',hyperparameters=HYPER,training=False)
+            before=training_state_digest(policy)
+            end=drive_interactive_episode(environment(),policy,human,task_id='frozen',epsilon=0,learn=False)
+            self.assertEqual(end.reward,1)
+            self.assertEqual(training_state_digest(policy),before)
+            self.assertEqual(policy.learner.replay_size,0)
+
+    def test_transport_abort_is_not_reward(self):
+        from agent_permission_harness_v1.longitudinal_rollout import drive_interactive_episode
+        with TemporaryDirectory() as d:
+            human,budget=human_at(Path(d)); self.addCleanup(budget.close)
+            human.transport.requester=lambda p: (_ for _ in ()).throw(TimeoutError('SENTINEL_SECRET'))
+            policy=FixtureDDQN(seed=17,device='cpu',hyperparameters=HYPER)
+            with self.assertRaises(RuntimeError):
+                drive_interactive_episode(environment(),policy,human,task_id='abort',epsilon=0,learn=True)
+            self.assertEqual(policy.learner.replay_size,0)
+        class BrokenPlanner:
+            def next_decision(self,*args): raise LiveCallError('sanitized')
+        with TemporaryDirectory() as d:
+            human,budget=human_at(Path(d)); self.addCleanup(budget.close)
+            policy=FixtureDDQN(seed=17,device='cpu',hyperparameters=HYPER)
+            with self.assertRaises(RuntimeError):
+                drive_interactive_episode(environment(BrokenPlanner()),policy,human,task_id='abort2',epsilon=0,learn=True)
+            self.assertEqual(policy.learner.replay_size,0)
+
+    def test_hidden_data_not_in_agent_or_features(self):
+        from agent_permission_harness_v1.longitudinal_rollout import drive_interactive_episode
+        from agent_permission_harness_v1.planner import StructuredOpenAIPlanner
+        captured=[]
+        class Capture:
+            def complete(self,prompt):
+                captured.append(prompt)
+                data=json.loads(prompt.split('\n',1)[1])
+                return ReactiveReadPlanner().next_decision(data['goal'],data['public_history'],data['available_calls'])
+        with TemporaryDirectory() as d:
+            human,budget=human_at(Path(d)); self.addCleanup(budget.close)
+            env=environment(StructuredOpenAIPlanner(Capture()))
+            policy=FixtureDDQN(seed=17,device='cpu',hyperparameters=HYPER)
+            end=drive_interactive_episode(env,policy,human,task_id='hidden',epsilon=0,learn=True)
+            self.assertEqual(end.reward,1)
+            self.assertNotIn('PERSONA_SECRET',''.join(captured))
+            self.assertNotIn('necessity_status',''.join(captured))
+            self.assertEqual(tuple(policy.learner._buffer._items[0].state.shape),(38,))
+            self.assertEqual(tuple(policy.learner._buffer._items[0].candidates.shape),(64,35))
