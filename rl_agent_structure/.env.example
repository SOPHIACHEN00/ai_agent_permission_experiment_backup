# Copy to rl_agent_structure/.env and replace the placeholder.
# One OpenRouter key is used for the LLM planner and S-QSTN replies in run_online.py.
# Environment variables take precedence. DDQN and mock tools do not need a key.
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
# The runner uses the existing S-QSTN provider snapshot and shared cumulative ledger.
# No request is sent without --execute. Never commit the real .env file.
